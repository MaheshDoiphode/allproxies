# Local proxy bind
ALLPROXIES_HOST=127.0.0.1
ALLPROXIES_PORT=8787

# Optional key required by clients calling this proxy.
# Leave empty to accept any/no Authorization header (local-only).
ALLPROXIES_API_KEY=

# SQLite store (gitignored). Legacy data/antigravity-tokens.json is imported once.
ALLPROXIES_TOKEN_PATH=data/antigravity-tokens.db

# Upstream host preference: daily | daily-sandbox | prod
ALLPROXIES_ANTIGRAVITY_ENDPOINT=daily

# Optional override. If set, wins over ENDPOINT.
# ALLPROXIES_ANTIGRAVITY_BASE_URL=https://daily-cloudcode-pa.googleapis.com

# Hub UA floor. Bumped automatically when the hub manifest is reachable.
ALLPROXIES_ANTIGRAVITY_HUB_VERSION=2.9.1

# Fetch live models (0 to use only data/models.json)
ALLPROXIES_LIVE_MODELS=1
ALLPROXIES_REQUEST_TIMEOUT_MS=480000

# Log incoming client bodies and the resolved upstream model/thinkingConfig.
ALLPROXIES_DEBUG_REQUESTS=0

# Optional dashboard password. Empty = local dashboard is open (127.0.0.1 only).
ALLPROXIES_ADMIN_PASSWORD=

# Vertex Express / Agent Platform. Project is required for Gemini 4 models.
# ALLPROXIES_VERTEX_API_KEY=AQ....
# ALLPROXIES_VERTEX_LOCATION=global
# ALLPROXIES_VERTEX_PROJECT=project-ad5beb0a-c96e-4620-952
